---
import Base from '../layouts/Base.astro';
import { empresa } from '../data/empresa';
---

<Base titulo={`Página no encontrada | ${empresa.nombre}`} descripcion="Esta página no existe.">
  <section class="contenedor" style="padding-top: 56px">
    <h1>Esta página no existe</h1>
    <p>Puede que la dirección haya cambiado.</p>
    <a class="boton" href="/">Ir al inicio</a>
  </section>
</Base>
